{
  "permissions": {
    "allow": [
      "mcp__microsoft-learn__microsoft_docs_search",
      "mcp__microsoft-learn__microsoft_docs_fetch",
      "mcp__microsoft-learn__microsoft_code_sample_search",
      "WebSearch",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:devblogs.microsoft.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:martinfowler.com)",
      "WebFetch(domain:microservices.io)",
      "Bash(pwsh -NoProfile -File scripts/state.ps1:*)",
      "Bash(pwsh -NoProfile -File scripts/render-guide.ps1:*)"
    ],
    "deny": [
      "Edit(/runs/*/approval.json)",
      "Edit(/runs/*/approval/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
